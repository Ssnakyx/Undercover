# URL du serveur Socket.io/Express (server/), sans slash final.
# En local : http://localhost:3001 (valeur par défaut si la variable est absente).
# En prod (Vercel) : à définir dans Project Settings > Environment Variables,
# avec l'URL publique du serveur déployé (ex: https://lolcover-server.onrender.com).
VITE_SERVER_URL=http://localhost:3001
